<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="space.f1nn.chorus" path="/space/f1nn/chorus/">
    <key name="window-width" type="i">
      <default>420</default>
    </key>
    <key name="window-height" type="i">
      <default>640</default>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
    </key>
    <key name="provider" type="s">
      <default>'lrcmux'</default>
    </key>
    <key name="provider-config" type="s">
      <default>'{}'</default>
    </key>
    <key name="lyrics-size" type="d">
      <range min="0.5" max="2.0"/>
      <default>1.0</default>
    </key>
    <key name="lyrics-blur" type="d">
      <range min="0.0" max="1.0"/>
      <default>0.35</default>
    </key>
    <key name="lyrics-padding" type="d">
      <range min="0.0" max="1.5"/>
      <default>0.5</default>
    </key>
    <key name="background-blur" type="d">
      <range min="0.0" max="1.0"/>
      <default>0.9</default>
    </key>
    <key name="background-opacity" type="d">
      <range min="0.0" max="1.0"/>
      <default>1.0</default>
    </key>
  </schema>
</schemalist>
